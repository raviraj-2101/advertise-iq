<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Welcome to Finanz!</title>
    <style>
      body {
        font-family: Arial, sans-serif;
        margin: 0;
        padding: 0;
        background-color: #f4f7fc;
        color: #333;
      }

      .container {
        width: 100%;
        max-width: 600px;
        margin: 50px auto;
        padding: 20px;
        background-color: #fff;
        border-radius: 10px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
      }

      .header {
        text-align: center;
        margin-bottom: 20px;
      }

      .name {
        font-size: 20px;
        font-weight: bold;
        background-color: #f2f2f2;
        padding: 10px;
        border-radius: 5px;
        text-align: center;
        margin-top: 20px;
        color: #333;
      }

      h2 {
        font-size: 24px;
        color: #0282b2;
      }

      p {
        font-size: 16px;
        line-height: 1.5;
      }

      .button-container {
        text-align: center;
        margin-top: 30px;
      }

      .button {
        padding: 12px 20px;
        background-color: #0282b2;
        color: white !important;
        font-size: 16px;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        text-decoration: none;
      }

      .button:hover {
        background-color: #0282b2;
      }

      footer {
        text-align: center;
        margin-top: 40px;
        font-size: 14px;
        color: #888;
      }
    </style>
  </head>

  <body>
    <div class="container">
      <div class="header">
        <h2>Welcome to Finanz!</h2>
        <p class="name">
          Dear <strong> <%= newCustomer.firstName %>, </strong>
        </p>
        <p>
          We are thrilled to welcome you to the Finanz community! You’ve
          successfully joined and are now ready to start exploring all the great
          features we offer.
        </p>
        <p>
          To get started, click the button below to verify your email and begin
          using Finanz:
        </p>

        <div class="button-container">
          <a href="<%= `${clientUrl}/verify-email/${token}` %>" class="button"
            >Verify your email</a
          >
        </div>
        <p style="font-size: 14px; color: #888; margin-top: 20px">
          Please note: This link will expire in 7 days. If you did not expect
          this invitation, please ignore this email.
        </p>
      </div>

      <footer>
        <p>If you did not expect this invitation, please ignore this email.</p>
        <p>Thank you for being a part of our community!</p>
      </footer>
    </div>
  </body>
</html>
