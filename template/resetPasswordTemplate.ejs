<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgot Password Verification</title>
    <style>
      body {
        font-family: Arial, sans-serif;
        margin: 0;
        padding: 0;
        background-color: #f4f7fc;
        color: #333;
      }

      .container {
        width: 100%;
        max-width: 600px;
        margin: 50px auto;
        padding: 20px;
        background-color: #fff;
        border-radius: 10px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
      }

      .header {
        text-align: center;
        margin-bottom: 20px;
      }
      .name {
        font-size: 20px;
        font-weight: bold;
        background-color: #f2f2f2;
        padding: 10px;
        border-radius: 5px;
        text-align: center;
        margin-top: 20px;
        color: #333;
      }

      h2 {
        font-size: 24px;
        color: #0282b2;
      }

      p {
        font-size: 16px;
        line-height: 1.5;
      }

      .button-container {
        text-align: center;
        margin-top: 30px;
      }

      .button {
        padding: 12px 20px;
        background-color: #0282b2;
        color: white !important;
        font-size: 16px;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        text-decoration: none;
      }

      .button:hover {
        background-color: #0282b2;
      }

      footer {
        text-align: center;
        margin-top: 40px;
        font-size: 14px;
        color: #888;
      }
    </style>
  </head>

  <body>
    <div class="container">
      <div class="header">
        <h2>Forgot Password Verification</h2>
        <p class="name">Dear <strong> <%= user.firstName %>, </strong></p>
        <p>
          We received a request to reset your password. If you made this
          request, please click the link below to proceed:
        </p>

        <div class="button-container">
          <a href="<%= `${clientUrl}/new-password/${token}` %>" class="button"
            >Click here to reset your password</a
          >
        </div>
      </div>

      <footer>
        <p>
          If you did not request a password reset, please ignore this message.
        </p>
        <p>Thank you for using our service!</p>
      </footer>
    </div>
  </body>
</html>
